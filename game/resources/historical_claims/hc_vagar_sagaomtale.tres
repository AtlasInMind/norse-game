[ext_resource type="Script" path="res://scripts/historical_claim.gd" id="1_tf37k"]

[resource]
script = ExtResource("1_tf37k")
claim_text = "Sagas written centuries later - Egils saga, Hallfreðar saga, Grettis saga - all place Vágar as a trading and fishing harbor as far back as the 800s and 900s. They were set down long after the fact, by people who weren't there, so the oldest details are closer to memory passed down than to record."
era = 1
place = "Vágar/Kabelvåg"
certainty = 1
source_ids = Array[String](["SRC-HIST-095"])
