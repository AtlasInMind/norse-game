script = ExtResource("1_tf37k")
claim_text = "On Vestvågøy, a farmer ploughing his own field in 1981 turned up the remains of an 83-metre chieftain's hall - not through any planned dig, just ordinary farm work breaking through into something that had waited underneath the whole time."
era = 1
place = "Borg"
certainty = 0
