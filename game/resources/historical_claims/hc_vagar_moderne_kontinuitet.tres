[resource]
script = ExtResource("1_tf37k")
claim_text = "Vágar - Kabelvåg today - is still a working fishing village tied to the Lofoten fisheries. Unlike Kaupang, which was abandoned and never resettled, this is one of the rare places where the thread from the Viking Age to now was never actually cut."
era = 0
place = "Vágar/Kabelvåg"
certainty = 0
source_ids = Array[String](["SRC-HIST-094", "SRC-HIST-100"])
