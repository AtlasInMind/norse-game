[resource]
script = ExtResource("1_dn")
speaker = "Torolv"
text = "Sagaene nevner Vágar helt tilbake på 800- og 900-tallet som handels- og fiskevær. Men husk - sagaene ble skrevet ned lenge etter, så de eldste detaljene er usikre."
era = 1
related_claims = Array[ExtResource("2_hcscript")]([ExtResource("3_claim")])
choices = Array[ExtResource("4_dcscript")]([ExtResource("5_choice_dokumentert"), ExtResource("6_choice_fortelling")])
