[gd_resource type="Resource" script_class="DialogueNode" format=3]

[ext_resource type="Script" path="res://scripts/dialogue_node.gd" id="1_dn"]
[ext_resource type="Script" path="res://scripts/historical_claim.gd" id="2_hcscript"]
[ext_resource type="Resource" path="res://resources/historical_claims/hc_vagar_sagaomtale.tres" id="3_claim"]
[ext_resource type="Script" path="res://scripts/dialogue_choice.gd" id="4_dcscript"]
[ext_resource type="Resource" path="res://resources/dialogue/dc_torolv_choice_mast.tres" id="5_choice_mast"]
[ext_resource type="Resource" path="res://resources/dialogue/dc_torolv_choice_busy.tres" id="6_choice_busy"]

[resource]
script = ExtResource("1_dn")
speaker = "Torolv"
text = "Every skipper touches the mast before rounding that point out there. Ships have stopped here as long as anyone can say - my grandfather's grandfather heard the same thing from his own elders. Who's to say how far back it truly goes."
era = 1
related_claims = Array[ExtResource("2_hcscript")]([ExtResource("3_claim")])
choices = Array[ExtResource("4_dcscript")]([ExtResource("5_choice_mast"), ExtResource("6_choice_busy")])
