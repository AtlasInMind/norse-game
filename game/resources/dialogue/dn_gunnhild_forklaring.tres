[resource]
script = ExtResource("1_dn")
speaker = "Gunnhild"
text = "No idea. It's just always been there. Funny thing, though - a farmer out past here once turned up the remains of an entire Viking chieftain's hall, just from ploughing his field. Eighty-one, I think it was. People still talk about it. Makes you wonder what's under half the farms around here."
era = 0
