[resource]
script = ExtResource("1_dn")
speaker = "Gunnhild"
text = "Aner ikke, har alltid vært der. Men vet du hva - et sted lenger ut i Lofoten fant en bonde faktisk restene av et helt vikinghøvdinghus da han pløyde jordet sitt, i 1981. Kanskje det er noe lignende her òg, hvem vet."
era = 0
