[ext_resource type="Resource" path="res://resources/dialogue/dc_torolv_ask_kirke.tres" id="3_choice"]

[resource]
script = ExtResource("1_dn")
speaker = "Torolv"
text = "Dokumentert, ja, i den forstand at det står skrevet - i sagaene. Men de ble satt ned på pergament lenge etter min tid, av folk som aldri var her. Skrevet ned, men ikke sett med egne øyne av den som skrev det."
era = 1
choices = Array[ExtResource("2_dcscript")]([ExtResource("3_choice")])
