[ext_resource type="Resource" path="res://resources/historical_claims/hc_saltstraumen_vikinggrav.tres" id="3_claim"]

[resource]
script = ExtResource("1_dn")
speaker = "Bjørn"
text = "En pilspiss, en glassperle, en øks - rett under huset vårt! De sa det trolig var en vikinggrav. Men de sa også at det ikke betyr at alle husene her rundt står på graver - bare at akkurat dette stedet gjorde det."
era = 0
related_claims = Array[ExtResource("2_hcscript")]([ExtResource("3_claim")])
