[ext_resource type="Resource" path="res://resources/historical_claims/hc_saltstraumen_vikinggrav.tres" id="3_claim"]

[resource]
script = ExtResource("1_dn")
speaker = "Bjørn"
text = "An arrowhead, a glass bead, an axe head - right under our house. They said it was probably a Viking grave. Said it doesn't mean every house around here is sitting on one, mind - just that ours was. I try not to think about it too much. Doesn't stop me thinking about it."
era = 0
related_claims = Array[ExtResource("2_hcscript")]([ExtResource("3_claim")])
completion_condition = "snakket_med_bjorn_om_funnet"
