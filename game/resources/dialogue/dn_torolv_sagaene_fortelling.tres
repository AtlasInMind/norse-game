[resource]
script = ExtResource("1_dn")
speaker = "Torolv"
text = "Ikke bare det, nei - det står i sagaene, ikke bare i minnet til folk som forteller det videre muntlig. Men en skrevet historie, satt ned lenge etterpå, er heller ikke det samme som å ha sett det selv."
