[resource]
script = ExtResource("1_dn")
speaker = "Torolv"
text = "As long as anyone now living can say - and longer than that, if the old stories are worth anything. Ships stop here because ships have always stopped here. Not much of an answer, I know. It's the only one I have."
era = 1
