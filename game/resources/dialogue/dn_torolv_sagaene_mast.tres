[ext_resource type="Resource" path="res://resources/dialogue/dc_torolv_ask_kirke.tres" id="3_choice"]

[resource]
script = ExtResource("1_dn")
speaker = "Torolv"
text = "Because the ones who didn't never came back to tell you why you should have. That's reason enough for me. I don't ask what's under the water - I just touch the mast and get on with the crossing."
era = 1
choices = Array[ExtResource("2_dcscript")]([ExtResource("3_choice")])
